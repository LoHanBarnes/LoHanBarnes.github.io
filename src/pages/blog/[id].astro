---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  )

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }))
}

const { post, prev, next } = Astro.props
const { Content } = await render(post)
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <a href="/blog" class="back-link">← Back to Blog</a>

  <h1>{post.data.title}</h1>

  <p class="post-date">
    {post.data.date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })}
  </p>

  <Content />

  <nav class="post-nav" aria-label="More blog entries">
    {prev ? (
      <a href={`/blog/${prev.id}/`} class="post-nav__link post-nav__link--prev">
        <span class="post-nav__label">← Previous</span>
        <span class="post-nav__title">{prev.data.title}</span>
      </a>
    ) : <span />}

    {next ? (
      <a href={`/blog/${next.id}/`} class="post-nav__link post-nav__link--next">
        <span class="post-nav__label">Next →</span>
        <span class="post-nav__title">{next.data.title}</span>
      </a>
    ) : <span />}
  </nav>

  <style lang="scss">
    .back-link {
      display: inline-block;
      margin-bottom: 2rem;

      font: 400 12px / 1 font-family(fraktion);
      letter-spacing: 0.05em;
      text-decoration: none;
      text-transform: uppercase;

      &:hover {
        text-decoration: underline;
      }
    }

    .post-date {
      margin: -1.5rem 0 2rem;

      font: 400 12px / 1 font-family(fraktion);
      letter-spacing: 0.05em;
      opacity: 0.7;
      text-transform: uppercase;
    }

    .post-nav {
      @include flex(row, stretch, space-between);

      margin-top: 3rem;
      padding-top: 2rem;

      border-top: 1px solid color(secondary);

      @include mq(phone) {
        flex-direction: column;
        gap: 1.5rem;
      }

      &__link {
        display: block;
        max-width: 45%;

        text-decoration: none;

        @include mq(phone) {
          max-width: 100%;
        }

        &--next {
          margin-left: auto;
          text-align: right;
        }
      }

      &__label {
        display: block;

        font: 400 12px / 1 font-family(fraktion);
        letter-spacing: 0.05em;
        opacity: 0.7;
        text-transform: uppercase;
      }

      &__title {
        display: block;
        margin-top: 0.35rem;

        font: 700 1.1rem / 1.3 font-family(fraktion);
        text-transform: uppercase;
      }

      &__link:hover &__title {
        text-decoration: underline;
      }
    }
  </style>
</Layout>
