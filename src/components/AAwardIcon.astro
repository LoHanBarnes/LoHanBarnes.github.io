---
// Simple stroke-based icon set for the awards grid. Add a new key here to
// use a new icon in src/config/awards.ts.
const { icon, class: className } = Astro.props

const icons: Record<string, string> = {
  trophy: `
    <path d="M6 4h12v4a6 6 0 0 1-12 0V4Z" />
    <path d="M6 6H3.5A1.5 1.5 0 0 0 2 7.5v1A3.5 3.5 0 0 0 5.5 12" />
    <path d="M18 6h2.5A1.5 1.5 0 0 1 22 7.5v1A3.5 3.5 0 0 1 18.5 12" />
    <path d="M12 14v4" />
    <path d="M9 21h6" />
    <path d="M9 19h6v2H9v-2Z" />
  `,
  medal: `
    <circle cx="12" cy="14.5" r="6" />
    <path d="M9 8.5 6.5 2" />
    <path d="M15 8.5 17.5 2" />
  `,
  lightbulb: `
    <path d="M9 18h6" />
    <path d="M10 21h4" />
    <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2.3h6c0-1.1.4-1.8 1-2.3A7 7 0 0 0 12 2Z" />
  `,
  star: `
    <path d="M12 2.5 14.9 9l7 .6-5.3 4.6 1.6 6.8-6.2-3.7-6.2 3.7 1.6-6.8-5.3-4.6 7-.6L12 2.5Z" />
  `,
  gear: `
    <polygon points="12,3 19,7.5 19,16.5 12,21 5,16.5 5,7.5" />
    <circle cx="12" cy="12" r="3.2" />
  `,
  book: `
    <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z" />
    <path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13Z" />
  `,
}
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  set:html={icons[icon] || icons.star}
/>
