---
const menu = [
  { id: '/', text: 'Home' },
  { id: '/resources', text: 'Resources' },
  { id: '/wet-invention-challenge', text: 'WET Challenge' },
  { id: '/capstone-project', text: 'Capstone' },
  { id: '/past-projects', text: 'Past Projects' },
  { id: '/blog', text: 'Blog' },
]
---

<footer class="site-foot">
  <div class="site-foot__logo">
    <a href="/">
      <svg width="280" height="280" viewBox="0 0 280 280" xmlns="http://www.w3.org/2000/svg">
        <text
          x="140"
          y="205"
          text-anchor="middle"
          font-family="sans-serif"
          font-weight="700"
          font-size="220"
          fill="var(--color-secondary)"
        >LB</text>
      </svg>

      <span class="u-sr-only">LoHan Barnes</span>
    </a>
  </div><!-- .site-foot__logo -->

  <nav class="site-foot__nav" aria-label="Site pages">
    <ul>
      {menu.map((item) => (
        <li><a href={item.id}>{item.text}</a></li>
      ))}
    </ul>
  </nav><!-- .site-foot__nav, always visible so pages stay reachable on mobile -->
</footer>

<style lang="scss">
  .site-foot {
    @include flex(row, center, space-between);

    position: relative;
    z-index: 3;

    padding: 1.5rem;

    border-top: 1px solid color(secondary);

    @include mq(phone) {
      @include flex(column, center, center);

      padding: 1rem;
    }

    &__logo {
      svg {
        display: block;
        width: 3rem;
        height: 3rem;

        @include mq(phone) {
          width: 1.875rem;
          height: 1.875rem;
        }
      }
    }

    &__nav {
      ul {
        @include flex(row, center, center);

        margin: 0;
        padding: 0;

        list-style: none;

        flex-wrap: wrap;

        @include mq(phone) {
          margin-top: 0.75rem;
          justify-content: center;
        }
      }

      li {
        margin: 0 0 0 1.5rem;

        @include mq(phone) {
          margin: 0.25rem 0.75rem;
        }
      }

      a {
        color: color(secondary);
        font: 400 12px / 1 font-family(fraktion);
        letter-spacing: 0.05em;
        text-decoration: none;
        text-transform: uppercase;

        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>
